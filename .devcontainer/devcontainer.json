{
  "name": "bdfp-241091038",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [9870, 8080, 8081, 8082, 8083, 4040, 18080, 29092],
  "portsAttributes": {
    "9870": { "label": "HDFS NameNode UI" },
    "8080": { "label": "Spark master UI" },
    "8082": { "label": "Flink UI" },
    "4040": { "label": "Spark driver UI" },
    "18080": { "label": "Spark History" }
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt || echo 'WARN: pip install failed; run it manually'"
}
