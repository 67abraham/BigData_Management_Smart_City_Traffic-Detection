# Copy to .env (git-ignored) only if you need to change a default. No secrets are required for M0.
COMPOSE_PROJECT_NAME=bdfp
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.5.3
KAFKA_VERSION=3.7.1
FLINK_VERSION=1.18.1
FLINK_KAFKA_CONNECTOR_VERSION=3.1.0-1.18
# Simple-auth user that Spark jobs act as on HDFS
HADOOP_USER_NAME=root
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m
# Any fixed string works for a single-broker KRaft dev cluster
KAFKA_CLUSTER_ID=bdfp-kraft-cluster-0001
