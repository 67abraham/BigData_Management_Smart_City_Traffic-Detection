# Copy to .env (git-ignored) only if you need to change a default. No secrets are required for M0.
COMPOSE_PROJECT_NAME=bdfp
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.5.3
KAFKA_VERSION=3.7.1
FLINK_VERSION=1.18.1
FLINK_KAFKA_CONNECTOR_VERSION=3.1.0-1.18
# Simple-auth user that Spark jobs act as on HDFS
HADOOP_USER_NAME=root
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m
# KRaft cluster id: must be a 22-char base64 UUID (generate: kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# KITTI (M1): download links for the 2D object detection benchmark.
# How to get them:
#   1. Register at https://www.cvlibs.net/datasets/kitti/ and accept the licence (CC BY-NC-SA 3.0).
#   2. Open "Object" -> "2D Object" and copy the links of these two files:
#        KITTI_LABEL_URL -> data_object_label_2.zip  (training labels, ~5.6 MB, downloaded in full)
#        KITTI_IMAGE_URL -> data_object_image_2.zip  (left colour images, ~12.6 GB; only the 500 sampled
#                           images are read via HTTP range requests, the full zip is never downloaded)
# The links are plain public S3 URLs (no token), but they are left empty here so that every user
# goes through KITTI's registration and licence. Only the manifest is published; images are never committed.
KITTI_LABEL_URL=
KITTI_IMAGE_URL=


