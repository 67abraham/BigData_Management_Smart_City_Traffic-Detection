# Copy to .env (git-ignored) only if you need to change a default. No secrets are required for M0.
COMPOSE_PROJECT_NAME=bdfp
HADOOP_VERSION=3.3.6
SPARK_VERSION=3.5.3
KAFKA_VERSION=3.7.1
FLINK_VERSION=1.18.1
FLINK_KAFKA_CONNECTOR_VERSION=3.1.0-1.18
# Simple-auth user that Spark jobs act as on HDFS
HADOOP_USER_NAME=root
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1536m
# KRaft cluster id: must be a 22-char base64 UUID (generate: kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# KITTI (M1): personal download links from your KITTI account e-mail. Never commit real values.
# Paste the data_object_label_2.zip and data_object_image_2.zip links (left empty here on purpose).
KITTI_LABEL_URL=
KITTI_IMAGE_URL=
